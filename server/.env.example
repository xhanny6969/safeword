# Copy to server/.env and fill in. Never commit the real file.

# From @BotFather. Send /start to the bot, add it to your circle group and send /circle there.
TELEGRAM_BOT_TOKEN=

# Optional
PORT=8788
HOST=127.0.0.1
# Seconds between a missed check-in and the alert (default 120)
GRACE_SEC=120
# IANA time zone for times shown to you and your circle (default: this machine)
TZ_NAME=
